<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 使用标准 .NET 9.0 框架（不使用 iOS workload） -->
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>N_m3u8DL_RE.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 当目标是 iOS 平台时的 NativeAOT 配置 -->
  <!-- 使用 PublishAotUsingRuntimePack 无需 iOS workload -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('ios')) Or $(RuntimeIdentifier.StartsWith('iossimulator'))">
    <!-- NativeAOT 配置 -->
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <!-- 生成共享库（.dylib），后续可以打包成 framework -->
    <NativeLib>Shared</NativeLib>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- iOS 特定配置 -->
    <DefineConstants>$(DefineConstants);IOS</DefineConstants>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 裁剪配置 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <!-- 关闭不需要的功能以减小体积 -->
    <StripSymbols>false</StripSymbols>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <!-- 非 iOS 平台使用标准配置 -->
  <PropertyGroup Condition="!$(RuntimeIdentifier.StartsWith('ios')) And !$(RuntimeIdentifier.StartsWith('iossimulator'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\N_m3u8DL-RE.Common\N_m3u8DL-RE.Common.csproj" />
    <ProjectReference Include="..\N_m3u8DL-RE.Parser\N_m3u8DL-RE.Parser.csproj" />
  </ItemGroup>

</Project>
